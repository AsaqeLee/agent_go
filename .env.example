# Copy to .env and fill in values (do not commit .env).
# Loaded automatically by cmd/agent on startup (does not override existing exports).

# Required for OpenAI / most cloud providers
OPENAI_API_KEY=sk-...

# Optional — defaults shown
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama example:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Turn logs: 1/true (default) or 0/false
AGENT_VERBOSE=1

# Session message cap after each successful turn (0 = unlimited). Default in CLI is 40.
# AGENT_MAX_HISTORY_MESSAGES=40

# Durable profile JSON path (default .agent_memory.json). Set empty to disable disk.
# AGENT_MEMORY_PATH=.agent_memory.json

# Keep N newest user-turns with full tool trails; older turns are folded. Default 1.
# AGENT_KEEP_RECENT_FULL_TURNS=1

# Set true to skip LLM compression of trim summaries (extractive only).
# AGENT_DISABLE_LLM_SUMMARY=false

# Async task workers / queue size (full queue fails Submit immediately)
# AGENT_TASK_WORKERS=2
# AGENT_TASK_QUEUE=64

# Extra Chat retries on 429 / 5xx / transport errors. -1 disables.
# AGENT_LLM_MAX_RETRIES=2

# Local knowledge base root (enables list_docs / read_doc / search_docs).
# If unset and examples/kb exists in cwd, CLI auto-uses examples/kb.
# AGENT_DOCS_ROOT=examples/kb

# Chat history directory (atomic JSON per session id). "off" disables.
# AGENT_SESSION_DIR=.agent_sessions
# AGENT_SESSION_ID=default

# Stream tokens when the provider supports SSE. Default true.
# AGENT_STREAM=true

# RAG: grep (default) or vector (needs `agent index` output)
# AGENT_RETRIEVER=grep
# AGENT_INDEX_PATH=.agent_index.json
# OPENAI_EMBED_MODEL=text-embedding-3-small
# AGENT_EMBED_HASH=false

# MCP: path to mcp.json (see mcp.json.example). If unset, cwd mcp.json is used when present.
# AGENT_MCP_CONFIG=mcp.json
# AGENT_MCP_AUTO_APPROVE=false

# Plugin catalog (retriever / mcp / specialists / http). See agent.json.example.
# AGENT_CONFIG=agent.json

# Multi-model (same BASE_URL, different model ids)
# AGENT_MODEL_FALLBACK=
# AGENT_MODEL_SUMMARY=

# Read-only code repo sandbox (list_repo / read_repo). Default examples/repo if present.
# AGENT_REPO_ROOT=examples/repo

# IM exit: empty = in-memory; URL POSTs Feishu-shaped JSON
# AGENT_CHANNEL_WEBHOOK=

# HTTP: go run ./cmd/agent serve --addr :8080
# AGENT_HTTP_ADDR=:8080

# Durable async tasks (atomic JSON). "off" keeps them in-memory.
# AGENT_TASK_STORE=.agent_tasks.json

# Per-tool timeout / same-turn concurrency cap
# AGENT_TOOL_TIMEOUT_MS=60000
# AGENT_TOOL_CONCURRENCY=8
# Whole-run deadline for wait:false / hung LLM (0 disables)
# AGENT_RUN_TIMEOUT_MS=180000

# OpenTelemetry-shaped JSONL spans (agent.run / llm.chat / tool.*)
# AGENT_OTEL_JSONL=.agent_otel.jsonl
