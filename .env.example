# Copy to .env and fill in values (do not commit .env).
# Loaded automatically by cmd/agent on startup (does not override existing exports).

# Required for OpenAI / most cloud providers
OPENAI_API_KEY=sk-...

# Optional — defaults shown
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama example:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Turn logs: 1/true (default) or 0/false
AGENT_VERBOSE=1

# Session message cap after each successful turn (0 = unlimited). Default in CLI is 40.
# AGENT_MAX_HISTORY_MESSAGES=40

# Durable profile JSON path (default .agent_memory.json). Set empty to disable disk.
# AGENT_MEMORY_PATH=.agent_memory.json

# Keep N newest user-turns with full tool trails; older turns are folded. Default 1.
# AGENT_KEEP_RECENT_FULL_TURNS=1

# Set true to skip LLM compression of trim summaries (extractive only).
# AGENT_DISABLE_LLM_SUMMARY=false

# Async task workers / queue size
# AGENT_TASK_WORKERS=2
# AGENT_TASK_QUEUE=64

# Local knowledge base root (enables list_docs / read_doc / search_docs).
# If unset and examples/kb exists in cwd, CLI auto-uses examples/kb.
# AGENT_DOCS_ROOT=examples/kb
